# Server only: set these in Vercel Environment Variables. Never prefix the service key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy SUPABASE_SERVICE_ROLE_KEY is accepted only as a compatibility fallback.

# Vite browser configuration: only these two PUBLIC values go into the web build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-key
